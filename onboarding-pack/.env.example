# TaskFlow API – environment variable reference
# Generated by env-archaeologist scan of sample-app/src/config.js
#
# Copy this file to sample-app/.env and fill in every value that is
# marked REQUIRED before starting the server.

# -----------------------------------------------------------------------
# REQUIRED – no default, the app throws on startup if absent
# -----------------------------------------------------------------------

# PostgreSQL connection URL.
# Format: postgres://USER:PASSWORD@HOST:PORT/DATABASE
# Source: sample-app/src/config.js:22  (required('DATABASE_URL'))
DATABASE_URL=postgres://user:password@localhost:5432/taskflow

# Secret used to sign and verify session tokens.
# Use a long, random string (e.g. `openssl rand -hex 32`).
# Source: sample-app/src/config.js:25  (required('JWT_SECRET'))
JWT_SECRET=replace-with-a-long-random-secret

# -----------------------------------------------------------------------
# OPTIONAL – sensible defaults are applied when these are absent
# -----------------------------------------------------------------------

# TCP port the HTTP server listens on.
# Default: 8080
# Source: sample-app/src/config.js:18
PORT=8080

# How long a login session stays valid, in minutes.
# Default: 60
# Source: sample-app/src/config.js:28
SESSION_TTL_MINUTES=60

# Log verbosity level.
# Accepted values: debug | info | warn | error
# Default: info
# Source: sample-app/src/config.js:31
LOG_LEVEL=info
